        "Migration",
        "Publication",
        "Evasion",
        "Pillage",
        "Frappe Aérienne",
        "Renforcement",
        "Protestation",
        "Capitulation",
        "Expulsion",
        "Occupation",
        "Embuscade",
        "Découverte",
        "Patrouille De Combat",
        "Accident",
        "Opération",
        "Catastrophe Naturelle",
        "Signalement Et Information",
        "Libération",
        "Lynchage",
