export default {
  data() {
    return {
      searchQuery: "",
      searchDateRange: [], // Tableau pour stocker la plage de dates (date de début et de fin)
      searchNature: "", // Champ pour la nature d'incident
      searchProvince: "", // Champ pour la province
      results: [],
      loading: false,
      menu: false, // Menu pour le date picker
      natureOptions: [
        "Expulsion",
        "Attaque",
        "Affrontement Armé",
        "Bombardement",
        "Arrestation",
        "Manifestation Pacifique",
