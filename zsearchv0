        "Naufrage",
        "Tension",
        "Problème De Communication",
        "Rupture De Stocks Des Vivres",
        "Echauffourées",
        "Capitulation",
      ],
      provinceOptions: [
        "BAS-UÉLÉ",
        "HAUT-UÉLÉ",
        "ITURI",
        "TSHOPO",
        "KONGO CENTRAL",
        "KWANGO",
        "KWILU",
        "MAI-NDOMBE",
        "ÉQUATEUR",
        "MONGALA",
        "NORD-UBANGI",
        "SUD-UBANGI",
        "TSHUAPA",
