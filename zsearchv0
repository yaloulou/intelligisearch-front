        "HAUT-KATANGA",
        "LUALABA",
        "TANGANYIKA",
        "KINSHASA",
        "KASAÏ",
        "KASAÏ-CENTRAL",
        "KASAÏ-ORIENTAL",
        "LOMAMI",
        "SANKURU",
        "MANIEMA",
        "NORD-KIVU",
        "SUD-KIVU",
      ],
      headers: [
        { text: "Date Incident", value: "date_incident" },
        { text: "Province", value: "province_region" },
        { text: "Nature", value: "nature_incident" },
        { text: "Description", value: "description" },
        { text: "Dégâts humains", value: "degats_humains" },
        { text: "Document", value: "document", align: "center" }, // Nouvelle colonne avec icône de document
      ],
    };
  },
  computed: {
    formattedDateRange() {
      if (this.searchDateRange.length === 2) {
        return `${this.formatDate(this.searchDateRange[0])} - ${this.formatDate(
          this.searchDateRange[1]
        )}`;
      }
      return ""; // Si aucune plage n'est sélectionnée
    },
  },
  methods: {
    async performSearch() {
      this.loading = true;
      try {
        let query = "";

        // Ajouter la barre de recherche si spécifiée
        if (this.searchQuery) {
          query += `${this.searchQuery}`;
        }

        // Ajouter la plage de dates si spécifiée (facultatif)
        if (this.searchDateRange.length === 2) {
          const [startDate, endDate] = this.searchDateRange;
          query += query
            ? ` AND date_incident:[${startDate} TO ${endDate}]`
            : `date_incident:[${startDate} TO ${endDate}]`;
        }

        // Ajouter la nature si spécifiée
        if (this.searchNature) {
          query += query
            ? ` AND nature_incident:${this.searchNature}`
            : `nature_incident:${this.searchNature}`;
        }

        // Ajouter la province si spécifiée
        if (this.searchProvince) {
          query += query
            ? ` AND province_region:${this.searchProvince}`
            : `province_region:${this.searchProvince}`;
        }

        const response = await axios.get("http://localhost:9200/intel_v1/_search", {
          params: {
            q: query, // Utilise la requête modifiée
          },
          auth: {
            username: "elastic",
            password: "Lisu2024",
          },
        });

        this.results = response.data.hits.hits.map((hit) => ({
          id: hit._id, // Store _id here
          ...hit._source, // Spread the _source to include all incident details
        }));
      } catch (error) {
        console.error("Erreur lors de la recherche:", error);
      } finally {
        this.loading = false;
      }
    },
    formatDate(date) {
      const options = { year: "numeric", month: "2-digit", day: "2-digit" };
      return new Date(date).toLocaleDateString(undefined, options);
    },
    clearDate() {
      this.searchDateRange = []; // Réinitialiser la plage de dates
    },
    clearProvince() {
      this.searchProvince = ""; // Réinitialiser la province
    },
    clearNature() {
      this.searchNature = ""; // Réinitialiser la nature
    },
    viewDetails(id) {
      // Rediriger vers la page des détails
      this.$router.push({ name: "IncidentDetails", params: { id } });
    },
  },
};
</script>

